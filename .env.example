# Root Compose ports
LAGANI_API_PORT=8080
LAGANI_WEBSITE_PORT=3000

# API administration. Leave empty to disable every /admin route. Production
# must use a secret-manager value with at least 32 random bytes.
LAGANI_ADMIN_API_KEY=

# Browser origins only. Native iOS/Android do not use browser CORS and the
# marketing website does not call the API. Set this only if Expo web is served.
LAGANI_API_CORS_ALLOWED_ORIGINS=http://localhost:8082

# Safe local defaults. Enable scheduling/startup ingestion only when you intend
# to contact the live upstream market/news sources.
LAGANI_SCHEDULER_ENABLED=false
LAGANI_STARTUP_JOBS_ENABLED=false

# Public website values are compiled into the website image at build time.
LAGANI_SITE_URL=http://localhost:3000
LAGANI_APP_STORE_URL=
LAGANI_PLAY_STORE_URL=
LAGANI_SUPPORT_EMAIL=
