# HTTP server
PORT=8080
# Comma-separated exact origins or wildcard patterns supported by go-chi/cors.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://*
# Generate a long random value for production. If empty, /admin/* returns 503.
ADMIN_API_KEY=replace-with-at-least-32-random-characters

# SQLite cache. Production deployments must mount this path on persistent storage
# and run a single API replica while SQLite is in use.
DB_FILE=./data/lagani_cache.db

# Scheduler controls. Disable both in non-leader replicas or API-only processes.
SCHEDULER_ENABLED=true
STARTUP_JOBS_ENABLED=true

# NEPSE authentication and source URLs
WASM_FILE=./css.wasm
NEPSE_BASE_URL=https://nepalstock.com.np
NEPSE_PROVE_PATH=/api/authenticate/prove
NEPSE_COMPANY_LIST_PATH=/api/nots/company/list
NEPSE_DAILY_STATS_PATH=/api/nots/securityDailyTradeStat/58
NEPSE_TOP_GAINERS_PATH=/api/nots/top-ten/top-gainer?all=true
NEPSE_TOP_LOSERS_PATH=/api/nots/top-ten/top-loser?all=true
NEPSE_MARKET_STATUS_PATH=/api/nots/nepse-data/market-open
NEPSE_HISTORICAL_PRICE_PATH_FORMAT=/api/nots/market/graphdata/%d

# Merolagani source URLs
MEROLAGANI_BASE_URL=https://merolagani.com
MEROLAGANI_NEWS_PATH=/NewsList.aspx
MEROLAGANI_CHART_PATH=/handlers/TechnicalChartHandler.ashx

# Nepalipaisa source URLs. News is JSON-driven; the old homepage HTML selector
# is intentionally no longer used.
NEPALIPAISA_BASE_URL=https://www.nepalipaisa.com
NEPALIPAISA_NEWS_API_PATH=/api/GetNewsByCategory

# Cron expressions include seconds and run in Asia/Kathmandu.
# NEPSE trades Sunday-Thursday. Live jobs are staggered to avoid bursts.
MARKET_STATUS_SCHEDULE=0 */2 10-15 * * 0-4
PRICE_SCHEDULE=15 */5 11-14 * * 0-4
GAINER_SCHEDULE=30 */5 11-14 * * 0-4
LOSER_SCHEDULE=45 */5 11-14 * * 0-4
MARKET_CLOSE_PRICE_SCHEDULE=0 5 15 * * 0-4
MARKET_CLOSE_GAINER_SCHEDULE=0 6 15 * * 0-4
MARKET_CLOSE_LOSER_SCHEDULE=0 7 15 * * 0-4
COMPANY_SCHEDULE=0 0 2 * * *
NEWS_SCHEDULE=0 0 6,18 * * *
HISTORICAL_PRICE_SCHEDULE=0 0 18 * * *
MEROLAGANI_CHART_SCHEDULE=0 5 0 * * *
